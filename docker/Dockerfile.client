# syntax=docker/dockerfile:1
# pychat desktop client.
#
# Running the client natively is the recommended path:
#     pip install -e ".[client]" && python -m pychat.client
# This image exists for completeness and reproducibility. A GUI container needs the
# host's X11 socket; see the README for the exact docker run invocation.

FROM python:3.12-slim AS builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install "websockets>=12,<16" "cryptography>=42" "customtkinter>=5.2"

COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-deps .


FROM python:3.12-slim AS runtime

LABEL org.opencontainers.image.title="pychat client" \
      org.opencontainers.image.description="Encrypted group chat desktop client" \
      org.opencontainers.image.source="https://github.com/DareRelaqz1/no-mentors-chat" \
      org.opencontainers.image.licenses="MIT"

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# customtkinter is a Tk wrapper: pip alone is not enough, Tk itself is a system package.
RUN apt-get update \
 && apt-get install --no-install-recommends -y \
      python3-tk \
      tk \
      libx11-6 \
      libxft2 \
      libxss1 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

RUN useradd --system --uid 10001 --create-home --shell /bin/bash appuser \
 && mkdir -p /home/appuser/.pychat \
 && chown -R appuser:appuser /home/appuser

USER appuser
WORKDIR /home/appuser
ENTRYPOINT ["python", "-m", "pychat.client"]
