# Copy to .env and fill in. .env is gitignored and must never be committed.

# Required. Minimum 8 characters. The server refuses to start without it.
PYCHAT_ROOM_PASSWORD=

# Optional — defaults shown.
PYCHAT_PORT=8765
PYCHAT_DATA_DIR=./data
PYCHAT_LOG_LEVEL=INFO

# Optional. Public DNS name or IP placed in the TLS certificate SAN.
# Set this on the AWS host to the Elastic IP.
PYCHAT_PUBLIC_HOST=
